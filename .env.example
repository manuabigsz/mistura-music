# Client ID do app criado em https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=

# Endereço onde o app roda. Em desenvolvimento use 127.0.0.1 (o Spotify não aceita "localhost").
# O Redirect URI cadastrado no Spotify precisa ser exatamente APP_URL + /api/auth/callback
APP_URL=http://127.0.0.1:3000
